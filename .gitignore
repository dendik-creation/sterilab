# Dependencies
**/node_modules/

# Build and coverage output
**/dist/
**/dist-ssr/
**/coverage/
**/.vite/

# Local environment and machine-specific configuration
*.local
*.env
*.env.*
!.env.example
!.env.*.example

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Playwright test output and browser cache
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# TypeScript incremental build artifacts
*.tsbuildinfo

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local design/tooling state
**/.impeccable/

# Generated only during the asset-optimization build step
lab/assets-optimized/

# Vercel's local project-link metadata
**/.vercel/

# AI
.claude/
.cursor/
